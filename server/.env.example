# ── Bakong Open API ──────────────────────────────────────────────
# production: https://api-bakong.nbc.org.kh
# sit       : https://sit-api-bakong.nbc.org.kh
BAKONG_ENV=production

# 在 bakong.nbc.gov.kh 注册开发者后，NBC 发到注册邮箱的 access token（有效期 90 天）
BAKONG_TOKEN=

# 注册时使用的邮箱，token 过期后用它走 /v1/renew_token 自动续期
BAKONG_EMAIL=

# ── 收款方（你自己的 Bakong 账户，必须与你注册/KYC 的一致）─────────
# 个人账户形如 123456789@aclb，商户账户由 NBC 分配
BAKONG_ACCOUNT_ID=
MERCHANT_NAME=
MERCHANT_CITY=Phnom Penh
# 商户模式才需要；个人收款账户可留空
MERCHANT_ID=
ACQUIRING_BANK=

# ── 运行 ────────────────────────────────────────────────────────
PORT=8787
# bakong = 调真实 Bakong 校验；demo = 本地模拟 3 秒后置为已支付（仅演示用）
PAYMENT_MODE=bakong
# 单笔支付等待上限（秒），到期未收到款则标记为 expired
PAYMENT_TIMEOUT=180
# 对外可访问的站点根，用于生成 deeplink 的回调，可留空
PUBLIC_BASE_URL=
